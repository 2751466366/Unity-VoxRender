#pragma kernel CSMain

// ============================================================
//  SVO Path Tracing — 体素场景路径追踪计算着色器
//
//  参考 gltf_pathtrace.slang 的路径追踪架构，
//  结合 SVO_RayTracing.compute 的 DDA 遍历与坐标系。
//
//  特性：
//    1. 多弹射路径追踪（可配置 maxDepth）
//    2. BRDF 材质采样（Diffuse / Metal / Glass / Emissive）
//    3. 纯天空盒环境光照（无方向光，无阴影射线）
//    4. 子像素抗锯齿抖动 + 时域渐进累积
//    5. 俄罗斯轮盘赌路径终止
//    6. 萤火虫亮度钳制
// ============================================================

// ---- SVO 数据（由 SVOBuilder 上传） ----
StructuredBuffer<uint4>   _SVONodes;       // childMask, data, flags, _pad
StructuredBuffer<float4>  _SVOMaterials;   // 每 3 个 float4 一项 (48B)

float3 _SVORootMin;   // 根节点最小角（世界空间）
float  _SVOScale;     // 体素缩放
int    _SVODepth;     // 八叉树深度

// ---- 相机参数 ----
float4x4 _InverseVP;  // 逆 ViewProjection（裁剪空间 → 世界空间）
float3   _CameraPos;  // 相机世界坐标

// ---- 天空盒 Cubemap ----
TextureCube _SkyboxTex;
SamplerState sampler_SkyboxTex;
float _HasSkyCube;    // 1.0 = Cubemap 已绑定
float3 _SkyColor;     // 回退天空颜色

// ---- 路径追踪参数 ----
int  _MaxDepth;       // 最大弹射深度
int  _FrameCount;     // 累积帧数（0 = 首帧）

// ---- 输出 ----
RWTexture2D<float4> _PathTracingResult;

// ---- 常量 ----
static const float EPSILON = 1e-6f;
static const int   MAX_STEPS = 4096;
static const float PI = 3.14159265359f;
static const float INV_PI = 0.31830988618f;
static const float FIREFLY_THRESHOLD = 10.0f;

// ============================================================
//  伪随机数生成（xxhash32 + 排列种子）
// ============================================================
uint pcg(inout uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand(inout uint seed)
{
    seed = pcg(seed);
    return asfloat(0x3f800000u | (seed >> 9)) - 1.0f;
}

// ============================================================
//  BRDF 采样函数
// ============================================================

// 余弦加权半球采样（Diffuse / Lambert）
float3 SampleDiffuse(float3 N, inout uint seed)
{
    float u1 = rand(seed);
    float u2 = rand(seed);
    float r = sqrt(u1);
    float theta = 2.0f * PI * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0f - u1);

    float3 up = abs(N.y) < 0.999f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 T = normalize(cross(up, N));
    float3 B = cross(N, T);
    return normalize(T * x + B * y + N * z);
}

// GGX 微表面法线采样（Metal / Glossy）
float3 SampleGGX(float3 N, float roughness, inout uint seed)
{
    float u1 = rand(seed);
    float u2 = rand(seed);
    float a = roughness * roughness;
    float a2 = a * a;

    float phi = 2.0f * PI * u1;
    float cosTheta = sqrt((1.0f - u2) / (1.0f + (a2 - 1.0f) * u2));
    float sinTheta = sqrt(1.0f - cosTheta * cosTheta);

    float3 up = abs(N.y) < 0.999f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 T = normalize(cross(up, N));
    float3 B = cross(N, T);

    float3 H = T * (sinTheta * cos(phi)) + B * (sinTheta * sin(phi)) + N * cosTheta;
    return normalize(H);
}

// Schlick Fresnel
float SchlickFresnel(float F0, float cosTheta)
{
    return F0 + (1.0f - F0) * pow(1.0f - max(cosTheta, 0.0f), 5.0f);
}

// Smith G1 for GGX（可见性项）
float SmithG1_GGX(float3 w, float3 N, float roughness)
{
    float a2 = roughness * roughness * roughness * roughness;
    float cosTheta = max(0.0, dot(w, N));
    float sinTheta2 = 1.0f - cosTheta * cosTheta;
    return 2.0f / (1.0f + sqrt(1.0f + a2 * sinTheta2 / max(cosTheta * cosTheta, 1e-7f)));
}

// ============================================================
//  SVO 查找：给定网格空间整数坐标，返回叶子节点的 materialIndex
// ============================================================
int SVOLookup(int3 gridCoord)
{
    int nodeIdx = 0;
    int level = _SVODepth;
    int3 nodeMin = int3(0, 0, 0);

    [loop]
    while (level > 0)
    {
        uint4 node = _SVONodes[nodeIdx];
        uint childMask = node.x;
        uint data = node.y;
        uint flags = node.z;

        if ((flags & 256u) != 0u)
            return (int)data;

        int half = 1 << (level - 1);
        int cx = (gridCoord.x >= nodeMin.x + half) ? 1 : 0;
        int cy = (gridCoord.y >= nodeMin.y + half) ? 1 : 0;
        int cz = (gridCoord.z >= nodeMin.z + half) ? 1 : 0;
        int c = cx | (cy << 1) | (cz << 2);

        if ((childMask & (1u << c)) == 0u)
            return -1;

        nodeIdx = (int)data + c;
        nodeMin += int3(cx * half, cy * half, cz * half);
        level--;
    }

    uint4 leafNode = _SVONodes[nodeIdx];
    if ((leafNode.z & 256u) != 0u)
        return (int)leafNode.y;

    return -1;
}

// ============================================================
//  DDA 遍历 SVO（主射线）
// ============================================================
int TraverseSVO_DDA(float3 ro, float3 rd,
                    out float hitT, out float3 hitNGrid, out float hitSide,
                    out int3 hitVoxel)
{
    hitT     = -1.0;
    hitNGrid = float3(0, 1, 0);
    hitSide  = 1.0;
    hitVoxel = int3(0, 0, 0);

    float rootSide = exp2((float)_SVODepth);

    float3 rdInv = float3(
        abs(rd.x) > EPSILON ? 1.0 / rd.x : 1e10 * sign(rd.x),
        abs(rd.y) > EPSILON ? 1.0 / rd.y : 1e10 * sign(rd.y),
        abs(rd.z) > EPSILON ? 1.0 / rd.z : 1e10 * sign(rd.z)
    );

    float3 t0 = -ro * rdInv;
    float3 t1 = (rootSide - ro) * rdInv;
    float3 tMin3 = min(t0, t1);
    float3 tMax3 = max(t0, t1);
    float tEnter = max(max(tMin3.x, tMin3.y), tMin3.z);
    float tExit  = min(min(tMax3.x, tMax3.y), tMax3.z);

    if (tEnter > tExit || tExit < 0.0)
        return -1;

    tEnter = max(tEnter, 0.0);

    float3 currentVoxel = floor(ro + rd * tEnter);
    currentVoxel = clamp(currentVoxel, float3(0, 0, 0), float3(rootSide - 1, rootSide - 1, rootSide - 1));

    float3 stepDir = sign(rd);
    float3 absRd = abs(rd);

    bool zeroX = absRd.x < EPSILON;
    bool zeroY = absRd.y < EPSILON;
    bool zeroZ = absRd.z < EPSILON;

    float3 tDelta = float3(
        zeroX ? 1e10 : 1.0 / absRd.x,
        zeroY ? 1e10 : 1.0 / absRd.y,
        zeroZ ? 1e10 : 1.0 / absRd.z
    );

    float3 nextBoundary = stepDir > 0 ? currentVoxel + 1.0 : currentVoxel;
    float3 tMax = (nextBoundary - (ro + rd * tEnter)) / rd;
    if (zeroX) tMax.x = 1e10;
    if (zeroY) tMax.y = 1e10;
    if (zeroZ) tMax.z = 1e10;

    if (tEnter > 0.0)
    {
        if (tMin3.x >= tMin3.y && tMin3.x >= tMin3.z)
            hitNGrid = float3(-sign(rd.x), 0, 0);
        else if (tMin3.y >= tMin3.x && tMin3.y >= tMin3.z)
            hitNGrid = float3(0, -sign(rd.y), 0);
        else
            hitNGrid = float3(0, 0, -sign(rd.z));
    }
    else
    {
        if (absRd.x >= absRd.y && absRd.x >= absRd.z)
            hitNGrid = float3(-stepDir.x, 0, 0);
        else if (absRd.y >= absRd.x && absRd.y >= absRd.z)
            hitNGrid = float3(0, -stepDir.y, 0);
        else
            hitNGrid = float3(0, 0, -stepDir.z);
    }

    [loop]
    for (int s = 0; s < MAX_STEPS; s++)
    {
        if (any(currentVoxel < 0) || any(currentVoxel >= rootSide))
            break;

        int3 coord = int3(currentVoxel);
        int matIndex = SVOLookup(coord);

        if (matIndex >= 0)
        {
            hitT = tEnter;
            hitSide = 1.0;
            hitVoxel = coord;
            return matIndex;
        }

        float stepT;
        if (tMax.x < tMax.y)
        {
            if (tMax.x < tMax.z)
            {
                stepT = tMax.x;
                currentVoxel.x += stepDir.x;
                tMax.x += tDelta.x;
                hitNGrid = float3(-stepDir.x, 0, 0);
            }
            else
            {
                stepT = tMax.z;
                currentVoxel.z += stepDir.z;
                tMax.z += tDelta.z;
                hitNGrid = float3(0, 0, -stepDir.z);
            }
        }
        else
        {
            if (tMax.y < tMax.z)
            {
                stepT = tMax.y;
                currentVoxel.y += stepDir.y;
                tMax.y += tDelta.y;
                hitNGrid = float3(0, -stepDir.y, 0);
            }
            else
            {
                stepT = tMax.z;
                currentVoxel.z += stepDir.z;
                tMax.z += tDelta.z;
                hitNGrid = float3(0, 0, -stepDir.z);
            }
        }

        tEnter = stepT;
        if (tEnter > tExit)
            break;
    }

    return -1;
}

// ============================================================
//  网格空间方向 → 世界空间方向
//  SVO 网格空间 = 世界空间（仅平移+缩放），坐标轴方向一致，无需交换
// ============================================================
float3 GridDirToWorld(float3 gridD)
{
    return normalize(gridD);
}

// ============================================================
//  读取完整材质参数（48B = 3×float4）
//  slot0: type, weight, rough, spec
//  slot1: ior, att, flux, _pad
//  slot2: color.r, color.g, color.b, color.a
// ============================================================
struct VoxelMaterial
{
    float  type;
    float  weight;
    float  rough;
    float  spec;
    float  ior;
    float  att;
    float  flux;
    float3 color;
    float  alpha;
};

VoxelMaterial ReadMaterial(int matIndex)
{
    VoxelMaterial mat;
    uint base = (uint)matIndex * 3u;

    float4 slot0 = _SVOMaterials[base];
    float4 slot1 = _SVOMaterials[base + 1u];
    float4 slot2 = _SVOMaterials[base + 2u];

    mat.type   = slot0.x;
    mat.weight = slot0.y;
    mat.rough  = max(slot0.z, 0.01f);
    mat.spec   = slot0.w;
    mat.ior    = slot1.x;
    mat.att    = slot1.y;
    mat.flux   = slot1.z;
    mat.color  = slot2.rgb;
    mat.alpha  = slot2.w;

    return mat;
}

// ============================================================
//  采样天空颜色（世界空间方向）
// ============================================================
float3 SampleSky(float3 dir)
{
    if (_HasSkyCube > 0.5f)
        return _SkyboxTex.SampleLevel(sampler_SkyboxTex, dir, 0).rgb;
    return _SkyColor;
}

// ============================================================
//  路径追踪主循环
//
//  参考 gltf_pathtrace.slang 的 pathTrace() 结构：
//    for each depth:
//      1. Trace → SVO DDA 遍历
//      2. 未命中 → 天空贡献（环境光）
//      3. 命中 → 读取材质
//         a. 自发光 → 直接累积
//         b. BSDF sample → 新方向 + throughput 更新
//         c. 俄罗斯轮盘赌 → 概率终止
// ============================================================
float3 PathTrace(float3 roWorld, float3 rdWorld, inout uint seed)
{
    float3 radiance   = float3(0, 0, 0);
    float3 throughput = float3(1, 1, 1);
    bool   isInside   = false;

    float3 roGrid = (roWorld - _SVORootMin) / _SVOScale;
    float3 rdGrid = rdWorld / _SVOScale;

    for (int depth = 0; depth < _MaxDepth; depth++)
    {
        bool firstRay = (depth == 0);

        // ---- SVO DDA 遍历 ----
        float hitT, hitSide;
        float3 hitNGrid;
        int3 hitVoxel;
        int matIndex = TraverseSVO_DDA(roGrid, rdGrid, hitT, hitNGrid, hitSide, hitVoxel);

        // ---- 未命中 → 天空 ----
        if (matIndex < 0)
        {
            float3 skyCol = SampleSky(rdWorld);

            if (firstRay)
            {
                // 首射线未命中：直接返回天空颜色
                return skyCol;
            }

            // 非首射线：天空作为环境光贡献
            radiance += throughput * skyCol;
            return radiance;
        }

        // ---- 读取完整材质 ----
        VoxelMaterial mat = ReadMaterial(matIndex);

        // ---- 自发光材质 ----
        if (abs(mat.type - 3.0f) < 0.5f) // Emissive
        {
            radiance += throughput * mat.flux * mat.color;
            return radiance;
        }

        // ---- 确保法线朝外 ----
        // DDA 返回的法线指向射线来源方向：
        //   外部命中：法线与 rdGrid 同向（都指向体素内部）→ 需要翻转
        //   内部命中：法线与 rdGrid 反向（指向体素外部）→ 已正确，不翻转
        if (dot(hitNGrid, rdGrid) > 0.0f)
            hitNGrid = -hitNGrid;

        // ---- BSDF 采样：确定下一弹射方向 ----
        // 所有采样在网格空间完成（与 DDA 遍历一致），
        // 最后转换到世界空间供 SampleSky 使用。
        float3 newDirGrid;
        float3 newDirWorld;
        bool absorbed = false;

        if (abs(mat.type - 0.0f) < 0.5f) // Diffuse
        {
            // 法线在网格空间构建 TBN 帧，确保采样分布正确
            float3 NGrid = normalize(hitNGrid);
            newDirGrid = SampleDiffuse(NGrid, seed);
            newDirWorld = GridDirToWorld(newDirGrid);
            throughput *= mat.color;
        }
        else if (abs(mat.type - 1.0f) < 0.5f) // Metal
        {
            float3 NGrid = normalize(hitNGrid);
            float3 H = SampleGGX(NGrid, mat.rough, seed);
            float3 woGrid = normalize(-rdGrid);
            float3 wrGrid = reflect(-woGrid, H);

            float ndotwi = max(0.0, dot(NGrid, woGrid));
            float ndotwr = max(0.0, dot(NGrid, wrGrid));

            if (ndotwr > 0.0f)
            {
                newDirGrid = normalize(wrGrid);
                newDirWorld = GridDirToWorld(newDirGrid);

                float F0 = mat.spec;
                float cosTheta = max(0.0, dot(H, woGrid));
                float F = SchlickFresnel(F0, cosTheta);

                // PDF 修正：BSDF/pdf = F * G1(wi) / G1(wo)
                float G1_wi = SmithG1_GGX(woGrid, NGrid, mat.rough);
                float G1_wr = SmithG1_GGX(wrGrid, NGrid, mat.rough);
                throughput *= mat.color * F * (G1_wi / max(G1_wr, 1e-6f));
            }
            else
            {
                absorbed = true;
            }
        }
        else if (abs(mat.type - 2.0f) < 0.5f) // Glass
        {
            float3 NGrid = normalize(hitNGrid);
            float3 woGrid = normalize(-rdGrid);
            float cosTheta = dot(NGrid, woGrid);
            float etaI = isInside ? mat.ior : 1.0f;
            float etaT = isInside ? 1.0f : mat.ior;
            float eta = etaI / etaT;

            float F = SchlickFresnel(0.04f, abs(cosTheta));

            if (rand(seed) < F)
            {
                // ---- 反射（delta 分布，BSDF/pdf = 1，RR 概率 F 恰好约掉）----
                float3 wrGrid = reflect(-woGrid, NGrid);
                newDirGrid = normalize(wrGrid);
                newDirWorld = GridDirToWorld(newDirGrid);
                throughput *= mat.color;
            }
            else
            {
                float3 wtGrid = refract(-woGrid, NGrid, eta);
                if (length(wtGrid) < 0.001f)
                {
                    // 全内反射回退（同反射分支）
                    float3 wrGrid = reflect(-woGrid, NGrid);
                    newDirGrid = normalize(wrGrid);
                    newDirWorld = GridDirToWorld(newDirGrid);
                    throughput *= mat.color;
                }
                else
                {
                    // ---- 折射（delta 分布，BSDF/pdf 含 eta^2 恰好与 RR 概率约掉）----
                    newDirGrid = normalize(wtGrid);
                    newDirWorld = GridDirToWorld(newDirGrid);
                    isInside = !isInside;
                    throughput *= mat.color;
                }
            }
        }
        else // Cloud / Blend 等其他类型，按 Diffuse 处理
        {
            float3 NGrid = normalize(hitNGrid);
            newDirGrid = SampleDiffuse(NGrid, seed);
            newDirWorld = GridDirToWorld(newDirGrid);
            throughput *= mat.color;
        }

        if (absorbed)
            break;

        // ---- 设置下一弹射线 ----
        // 使用 DDA 精确命中点（保留空间连续性），而非体素中心
        float3 hitPosGrid = roGrid + rdGrid * hitT;
        // 逃逸偏移：沿弹射方向精确计算到当前体素边界的距离
        // 正分量→从上边界逃逸，负分量→从下边界逃逸，零分量→用法线兜底
        float3 escapeDist;
        escapeDist.x = abs(newDirGrid.x) > EPSILON ? (newDirGrid.x > 0 ? (1.0 - hitPosGrid.x % 1.0) : (hitPosGrid.x % 1.0)) / abs(newDirGrid.x) : abs(hitNGrid.x) * 0.5;
        escapeDist.y = abs(newDirGrid.y) > EPSILON ? (newDirGrid.y > 0 ? (1.0 - hitPosGrid.y % 1.0) : (hitPosGrid.y % 1.0)) / abs(newDirGrid.y) : abs(hitNGrid.y) * 0.5;
        escapeDist.z = abs(newDirGrid.z) > EPSILON ? (newDirGrid.z > 0 ? (1.0 - hitPosGrid.z % 1.0) : (hitPosGrid.z % 1.0)) / abs(newDirGrid.z) : abs(hitNGrid.z) * 0.5;
        roGrid = hitPosGrid + newDirGrid * (max(max(escapeDist.x, escapeDist.y), escapeDist.z) + 0.01f);
        rdGrid = newDirGrid;
        rdWorld = newDirWorld;

        // ---- 俄罗斯轮盘赌 ----
        float rrPcont = min(max(throughput.x, max(throughput.y, throughput.z)) + 0.001f, 0.95f);
        if (rand(seed) >= rrPcont)
            break;
        throughput /= rrPcont;
    }

    return radiance;
}

// ============================================================
//  像素采样（含子像素抖动）
// ============================================================
float3 SamplePixel(float2 samplePos, float2 jitter, float2 imageSize,
                   float4x4 invVP, inout uint seed)
{
    float2 clipCoords = (samplePos + jitter) / imageSize * 2.0 - 1.0;
    float4 farWorld = mul(invVP, float4(clipCoords, 1.0, 1.0));
    farWorld /= farWorld.w;

    float3 rd = normalize(farWorld.xyz - _CameraPos);
    float3 ro = _CameraPos;

    float3 result = PathTrace(ro, rd, seed);

    // 萤火虫软钳制（Reinhard 风格，平滑过渡无突变）
    result = result / (1.0f + result / FIREFLY_THRESHOLD);

    return result;
}

// ============================================================
//  CSMain — 每像素路径追踪 + 时域累积
// ============================================================
[numthreads(8, 8, 1)]
void CSMain(uint3 dtid : SV_DispatchThreadID)
{
    uint2 pixel = dtid.xy;
    uint2 dims;
    _PathTracingResult.GetDimensions(dims.x, dims.y);
    if (pixel.x >= dims.x || pixel.y >= dims.y) return;

    float2 samplePos = (float2)pixel;
    float2 imageSize = float2(dims);

    // 随机种子（基于像素位置 + 帧号）
    uint seed = (uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + (uint)_FrameCount * 26699u) | 1u;

    // 子像素抗锯齿抖动
    float2 jitter;
    if (_FrameCount == 0)
        jitter = float2(0.5f, 0.5f); // 首帧：像素中心
    else
        jitter = float2(rand(seed), rand(seed)); // 后续帧：随机抖动

    // 构建相机射线 + 路径追踪
    float3 color = SamplePixel(samplePos, jitter, imageSize, _InverseVP, seed);

    // 时域累积
    if (_FrameCount == 0)
    {
        _PathTracingResult[pixel] = float4(color, 1.0);
    }
    else
    {
        float4 old = _PathTracingResult[pixel];
        float totalSamples = (float)(_FrameCount + 1);
        float3 accumulated = (old.rgb * (totalSamples - 1.0f) + color) / totalSamples;
        _PathTracingResult[pixel] = float4(accumulated, 1.0);
    }
}
