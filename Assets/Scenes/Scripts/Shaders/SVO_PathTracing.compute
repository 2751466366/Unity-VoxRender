#pragma kernel CSMain

// DLSS 变体:C# 侧按 enableDLSS && 插件就绪 EnableKeyword/DisableKeyword("DLSS_ON")
// DLSS_OFF 变体不含 MV/深度 UAV,无绑定要求(回退路径零浪费,消除 not set 警告)
#pragma multi_compile_local _ DLSS_ON

// ============================================================
//  SVO Path Tracing — 体素场景路径追踪计算着色器
//
//  参考 gltf_pathtrace.slang 的路径追踪架构，
//  结合 SVO_RayTracing.compute 的 DDA 遍历与坐标系。
//
//  特性：
//    1. 多弹射路径追踪（可配置 maxDepth）
//    2. BRDF 材质采样（Diffuse / Metal / Glass / Emissive / Cloud / Blend）
//    3. NEE 直接光照估计 + MIS（Multiple Importance Sampling）
//    4. 统一光源采样框架（HDR 环境光 + 方向光 + 自发光体素）
//    5. 余弦加权半球环境光采样 + Cubemap 查询
//    6. 阴影射线可见性测试（体素中心出发 + skipVoxel 防自遮挡）
//    7. 子像素抗锯齿抖动 + 时域渐进累积
//    8. 俄罗斯轮盘赌路径终止
//    9. 萤火虫亮度钳制
// ============================================================

// ---- SVO 数据（由 SVOBuilder 上传） ----
StructuredBuffer<uint4>   _SVONodes;       // childMask, data, flags, _pad
StructuredBuffer<float4>  _SVOMaterials;   // 每 3 个 float4 一项 (48B)

// ---- 自发光体素光源（SVOBuilder 构建，NEE 采样用）----
StructuredBuffer<float4>  _EmissiveLights;       // xyz=grid coord (int as float), w=matIndex
StructuredBuffer<float2>  _EmissiveAliasTable;   // alias table: x=prob, y=alias
int                       _EmissiveLightCount;
float                     _EmissiveTotalPower;   // sum(pow(2,flux)*lum(color)) 不含 scale²

float3 _SVORootMin;   // 根节点最小角（世界空间）
float  _SVOScale;     // 体素缩放
int    _SVODepth;     // 八叉树深度

// ---- 相机参数 ----
float4x4 _InverseVP;  // 逆 ViewProjection（裁剪空间 → 世界空间）
float3   _CameraPos;  // 相机世界坐标

// ---- DLSS 支持（DLSS_ON 变体；颜色/MV/深度共用 C# 侧 jittered 投影矩阵）----
float4x4 _CurVP;           // 当前帧 ViewProjection（含 jitter，GL GPU 约定）
float4x4 _PrevVP;          // 上一帧 ViewProjection（含 jitter）
#ifdef DLSS_ON
RWTexture2D<float2> _MotionVectorRT; // 像素空间 MV，指向上一帧位置（DLSS 约定）
RWTexture2D<float>  _DepthRT;        // hardware depth [0,1]（near=0, far=1，非反转）
#endif

// ---- 天空盒 Cubemap ----
TextureCube _SkyboxTex;
SamplerState sampler_SkyboxTex;
float _HasSkyCube;    // 1.0 = Cubemap 已绑定
float3 _SkyColor;     // 回退天空颜色

// ---- 方向光（太阳）----
float3 _SunDir;       // 指向光源方向（世界空间）
float3 _SunColor;     // 光照颜色 × 强度
float  _HasSun;       // 1.0 = 方向光启用

// ---- 路径追踪参数 ----
int  _MaxDepth;       // 最大弹射深度
int  _FrameCount;     // 累积帧数（0 = 首帧）

// ---- 输出 ----
RWTexture2D<float4> _PathTracingResult;

// ---- 常量 ----
static const float EPSILON = 1e-6f;
static const int   MAX_STEPS = 1024;
static const float PI = 3.14159265359f;
static const float INV_PI = 0.31830988618f;
static const float FIREFLY_THRESHOLD = 5.0f;
static const float INFINITE = 1e30f;

// ============================================================
//  伪随机数生成（xxhash32 + 排列种子）
// ============================================================
uint pcg(inout uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand(inout uint seed)
{
    seed = pcg(seed);
    return asfloat(0x3f800000u | (seed >> 9)) - 1.0f;
}

// ============================================================
//  BRDF 采样函数
// ============================================================

// 余弦加权半球采样（Diffuse / Lambert）
float3 SampleDiffuse(float3 N, inout uint seed)
{
    float u1 = rand(seed);
    float u2 = rand(seed);
    float r = sqrt(u1);
    float theta = 2.0f * PI * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0f - u1);

    float3 up = abs(N.y) < 0.999f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 T = normalize(cross(up, N));
    float3 B = cross(N, T);
    return normalize(T * x + B * y + N * z);
}

// GGX 微表面法线采样（Metal / Glossy）
float3 SampleGGX(float3 N, float roughness, inout uint seed)
{
    float u1 = rand(seed);
    float u2 = rand(seed);
    float a = roughness * roughness;
    float a2 = a * a;

    float phi = 2.0f * PI * u1;
    float cosTheta = sqrt((1.0f - u2) / (1.0f + (a2 - 1.0f) * u2));
    float sinTheta = sqrt(1.0f - cosTheta * cosTheta);

    float3 up = abs(N.y) < 0.999f ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 T = normalize(cross(up, N));
    float3 B = cross(N, T);

    float3 H = T * (sinTheta * cos(phi)) + B * (sinTheta * sin(phi)) + N * cosTheta;
    return normalize(H);
}

// Schlick Fresnel
float SchlickFresnel(float F0, float cosTheta)
{
    return F0 + (1.0f - F0) * pow(1.0f - max(cosTheta, 0.0f), 5.0f);
}

// Smith G1 for GGX（可见性项）
float SmithG1_GGX(float3 w, float3 N, float roughness)
{
    float a2 = roughness * roughness * roughness * roughness;
    float cosTheta = max(0.0, dot(w, N));
    float sinTheta2 = 1.0f - cosTheta * cosTheta;
    return 2.0f / (1.0f + sqrt(1.0f + a2 * sinTheta2 / max(cosTheta * cosTheta, 1e-7f)));
}

// ============================================================
//  SVO 查找：给定网格空间整数坐标，返回叶子节点的 materialIndex
// ============================================================
int SVOLookup(int3 gridCoord)
{
    int nodeIdx = 0;
    int level = _SVODepth;
    int3 nodeMin = int3(0, 0, 0);

    [loop]
    while (level > 0)
    {
        uint4 node = _SVONodes[nodeIdx];
        uint childMask = node.x;
        uint data = node.y;
        uint flags = node.z;

        if ((flags & 256u) != 0u)
            return (int)data;

        int half = 1 << (level - 1);
        int cx = (gridCoord.x >= nodeMin.x + half) ? 1 : 0;
        int cy = (gridCoord.y >= nodeMin.y + half) ? 1 : 0;
        int cz = (gridCoord.z >= nodeMin.z + half) ? 1 : 0;
        int c = cx | (cy << 1) | (cz << 2);

        if ((childMask & (1u << c)) == 0u)
            return -1;

        nodeIdx = (int)data + c;
        nodeMin += int3(cx * half, cy * half, cz * half);
        level--;
    }

    uint4 leafNode = _SVONodes[nodeIdx];
    if ((leafNode.z & 256u) != 0u)
        return (int)leafNode.y;

    return -1;
}

struct SVOStackItem
{
    int  nodeIdx;
    int  level;
    int3 nodeMin;
    float tMin;
    float tMax;
};

int TraverseSVO_Stack(float3 ro, float3 rd,
                      out float hitT, out float3 hitPos,
                      out float3 hitNGrid, out float hitSide,
                      out int3 hitVoxel)
{
    hitT     = -1.0;
    hitPos   = float3(0, 0, 0);
    hitNGrid = float3(0, 1, 0);
    hitSide  = 1.0;
    hitVoxel = int3(0, 0, 0);

    float rootSide = exp2((float)_SVODepth);

    // ---------- 1. 预计算 rd 倒数 ----------
    float3 rdInv = float3(
        abs(rd.x) > EPSILON ? 1.0 / rd.x : (rd.x >= 0.0 ? 1e30 : -1e30),
        abs(rd.y) > EPSILON ? 1.0 / rd.y : (rd.y >= 0.0 ? 1e30 : -1e30),
        abs(rd.z) > EPSILON ? 1.0 / rd.z : (rd.z >= 0.0 ? 1e30 : -1e30)
    );

    // ---------- 2. 与根 AABB 求交 ----------
    float3 t0 = -ro * rdInv;
    float3 t1 = (rootSide - ro) * rdInv;
    float3 tMin3 = min(t0, t1);
    float3 tMax3 = max(t0, t1);
    float tEnter = max(max(tMin3.x, tMin3.y), tMin3.z);
    float tExit  = min(min(tMax3.x, tMax3.y), tMax3.z);

    if (tEnter > tExit || tExit < 0.0)
        return -1;

    tEnter = max(tEnter, 0.0);

    // ---------- 3. 初始化栈 ----------
    SVOStackItem stack[64];
    int sp = 0;

    // HLSL 不支持构造函数，逐字段赋值
    stack[sp].nodeIdx = 0;
    stack[sp].level   = _SVODepth;
    stack[sp].nodeMin = int3(0, 0, 0);
    stack[sp].tMin    = tEnter;
    stack[sp].tMax    = tExit;
    sp++;

    float3 absRd = abs(rd);

    // ---------- 4. 主遍历循环 ----------
    while (sp > 0)
    {
        sp--;
        SVOStackItem cur = stack[sp];

        // 如果当前节点比已找到的命中点更远，跳过
        if (hitT >= 0.0 && cur.tMin > hitT)
            continue;

        uint4 node = _SVONodes[cur.nodeIdx];
        uint childMask = node.x;
        uint data      = node.y;
        uint flags     = node.z;

        // ----- 叶子节点：命中 -----
        if ((flags & 256u) != 0u)
        {
            float voxelSize = float(1 << cur.level);
            float3 voxelMin = float3(cur.nodeMin);
            float3 voxelMax = voxelMin + voxelSize;

            hitT = cur.tMin;
            hitVoxel = cur.nodeMin;

            // 精确法线：看进入时哪个轴的 t 等于 cur.tMin
            float3 vt0 = (voxelMin - ro) * rdInv;
            float3 vt1 = (voxelMax - ro) * rdInv;
            float3 vMin3 = min(vt0, vt1);

            float3 n = float3(0, 0, 0);
            if (abs(vMin3.x - cur.tMin) < 1e-4) n.x = (rd.x > 0.0) ? -1.0 : 1.0;
            else if (abs(vMin3.y - cur.tMin) < 1e-4) n.y = (rd.y > 0.0) ? -1.0 : 1.0;
            else n.z = (rd.z > 0.0) ? -1.0 : 1.0;

            hitNGrid = n;
            hitSide  = (n.x != 0.0) ? 0.0 : ((n.y != 0.0) ? 1.0 : 2.0);

            // 精确坐标投影
            float3 precisePos = ro + rd * cur.tMin;
            if (n.x < -0.5) precisePos.x = voxelMin.x; else if (n.x > 0.5) precisePos.x = voxelMax.x;
            if (n.y < -0.5) precisePos.y = voxelMin.y; else if (n.y > 0.5) precisePos.y = voxelMax.y;
            if (n.z < -0.5) precisePos.z = voxelMin.z; else if (n.z > 0.5) precisePos.z = voxelMax.z;

            if      (absRd.x >= absRd.y && absRd.x >= absRd.z && abs(rd.x) > EPSILON)
                hitT = (precisePos.x - ro.x) * rdInv.x;
            else if (absRd.y >= absRd.x && absRd.y >= absRd.z && abs(rd.y) > EPSILON)
                hitT = (precisePos.y - ro.y) * rdInv.y;
            else
                hitT = (precisePos.z - ro.z) * rdInv.z;

            hitPos = ro + rd * hitT;

            if (n.x < -0.5) hitPos.x = voxelMin.x; else if (n.x > 0.5) hitPos.x = voxelMax.x;
            if (n.y < -0.5) hitPos.y = voxelMin.y; else if (n.y > 0.5) hitPos.y = voxelMax.y;
            if (n.z < -0.5) hitPos.z = voxelMin.z; else if (n.z > 0.5) hitPos.z = voxelMax.z;

            return (int)data;
        }

        // ----- 内部节点：下钻到子节点 -----
        int half = 1 << (cur.level - 1);
        float fHalf = float(half);
        float3 fNodeMin = float3(cur.nodeMin);

        // 收集被射线穿过的非空子节点（最多 4 个）
        // 注意：数组名不能与局部变量重名
        float childTMin[4];
        float childTMax[4];
        int   childNodeIdx[4];
        int   childLevel[4];
        int3  childMin[4];
        int   childCount = 0;

        [unroll]
        for (int i = 0; i < 8; i++)
        {
            if ((childMask & (1u << i)) == 0u)
                continue;

            int cx = i & 1;
            int cy = (i >> 1) & 1;
            int cz = (i >> 2) & 1;

            float3 childMinF = fNodeMin + float3(cx * fHalf, cy * fHalf, cz * fHalf);
            float3 childMaxF = childMinF + fHalf;

            float3 cT0 = (childMinF - ro) * rdInv;
            float3 cT1 = (childMaxF - ro) * rdInv;
            float3 cTMin3 = min(cT0, cT1);
            float3 cTMax3 = max(cT0, cT1);
            float cTMin = max(max(cTMin3.x, cTMin3.y), cTMin3.z);
            float cTMax = min(min(cTMax3.x, cTMax3.y), cTMax3.z);

            cTMin = max(cTMin, cur.tMin);
            cTMax = min(cTMax, cur.tMax);

            if (cTMin <= cTMax && cTMax >= 0.0)
            {
                if (hitT < 0.0 || cTMin <= hitT)
                {
                    childTMin[childCount]   = cTMin;
                    childTMax[childCount]   = cTMax;
                    childNodeIdx[childCount] = (int)data + i;
                    childLevel[childCount]   = cur.level - 1;
                    childMin[childCount]     = cur.nodeMin + int3(cx * half, cy * half, cz * half);
                    childCount++;
                }
            }
        }

        // 按 tMin 降序压栈（最小的最后压，栈顶先处理）
        // 最多 4 个元素，手动冒泡排序
        if (childCount > 1)
        {
            for (int a = 0; a < childCount - 1; a++)
            {
                for (int b = a + 1; b < childCount; b++)
                {
                    if (childTMin[a] < childTMin[b])
                    {
                        float tmpF = childTMin[a]; childTMin[a] = childTMin[b]; childTMin[b] = tmpF;
                        tmpF = childTMax[a]; childTMax[a] = childTMax[b]; childTMax[b] = tmpF;
                        int tmpI = childNodeIdx[a]; childNodeIdx[a] = childNodeIdx[b]; childNodeIdx[b] = tmpI;
                        tmpI = childLevel[a]; childLevel[a] = childLevel[b]; childLevel[b] = tmpI;
                        int3 tmpM = childMin[a]; childMin[a] = childMin[b]; childMin[b] = tmpM;
                    }
                }
            }
        }

        for (int k = 0; k < childCount; k++)
        {
            if (sp < 64)
            {
                stack[sp].nodeIdx = childNodeIdx[k];
                stack[sp].level   = childLevel[k];
                stack[sp].nodeMin = childMin[k];
                stack[sp].tMin    = childTMin[k];
                stack[sp].tMax    = childTMax[k];
                sp++;
            }
        }
    }

    return -1;
}

// ============================================================
//  网格空间方向 → 世界空间方向
//  SVO 网格空间 = 世界空间（仅平移+缩放），坐标轴方向一致，无需交换
// ============================================================
float3 GridDirToWorld(float3 gridD)
{
    return normalize(gridD);
}

// ============================================================
//  读取完整材质参数（48B = 3×float4）
//  slot0: type, weight, rough, spec
//  slot1: ior, att, flux, _pad
//  slot2: color.r, color.g, color.b, color.a
// ============================================================
struct VoxelMaterial
{
    float  type;
    float  weight;
    float  rough;
    float  spec;
    float  ior;
    float  att;
    float  flux;
    float3 color;
    float  alpha;
};

VoxelMaterial ReadMaterial(int matIndex)
{
    VoxelMaterial mat;
    uint base = (uint)matIndex * 3u;

    float4 slot0 = _SVOMaterials[base];
    float4 slot1 = _SVOMaterials[base + 1u];
    float4 slot2 = _SVOMaterials[base + 2u];

    mat.type   = slot0.x;
    mat.weight = slot0.y;
    mat.rough  = max(slot0.z, 0.01f);
    mat.spec   = slot0.w;
    mat.ior    = slot1.x;
    mat.att    = slot1.y;
    mat.flux   = slot1.z;
    mat.color  = slot2.rgb;
    mat.alpha  = slot2.w;

    return mat;
}

// ============================================================
//  采样天空颜色（世界空间方向）
// ============================================================
float3 SampleSky(float3 dir)
{
    return (_HasSkyCube > 0.5f)
        ? _SkyboxTex.SampleLevel(sampler_SkyboxTex, dir, 0).rgb
        : _SkyColor;
}

// ============================================================
//  NEE — DirectLight 结构体（参考 gltf_pathtrace.slang L63-69）
// ============================================================
struct DirectLight
{
    float3 direction;        // 指向光源的方向
    float3 radianceOverPdf;  // 辐射亮度 / PDF
    float  distance;         // 到光源距离（环境光 = INFINITE）
    float  pdf;              // 概率密度
};

// ============================================================
//  NEE — 阴影射线可见性测试（栈式 SVO 加速版）
//  充分利用稀疏性：空分支直接不压栈
// ============================================================
bool ShadowRayVisible_SVO(float3 roGrid, float3 lightDirGrid, int3 skipVoxel, float maxT)
{
    float rootSide = exp2((float)_SVODepth);

    // ---------- 1. 预计算 rd 倒数 ----------
    float3 rdInv = float3(
        abs(lightDirGrid.x) > EPSILON ? 1.0 / lightDirGrid.x : (lightDirGrid.x >= 0.0 ? 1e30 : -1e30),
        abs(lightDirGrid.y) > EPSILON ? 1.0 / lightDirGrid.y : (lightDirGrid.y >= 0.0 ? 1e30 : -1e30),
        abs(lightDirGrid.z) > EPSILON ? 1.0 / lightDirGrid.z : (lightDirGrid.z >= 0.0 ? 1e30 : -1e30)
    );

    // ---------- 2. 与根 AABB 求交 ----------
    float3 t0 = -roGrid * rdInv;
    float3 t1 = (rootSide - roGrid) * rdInv;
    float3 tMin3 = min(t0, t1);
    float3 tMax3 = max(t0, t1);
    float tEnter = max(max(tMin3.x, tMin3.y), tMin3.z);
    float tExit  = min(min(tMax3.x, tMax3.y), tMax3.z);

    if (tEnter > tExit || tExit < 0.0)
        return false;  // 保持与原 DDA 代码一致的语义

    tEnter = max(tEnter, 0.0);

    // 如果 SVO 最近交点都在光源之外 → 直接可见
    if (tEnter > maxT)
        return true;

    // ---------- 3. 初始化栈 ----------
    SVOStackItem stack[64];
    int sp = 0;

    stack[sp].nodeIdx = 0;
    stack[sp].level   = _SVODepth;
    stack[sp].nodeMin = int3(0, 0, 0);
    stack[sp].tMin    = tEnter;
    stack[sp].tMax    = min(tExit, maxT); // 超出 maxT 的部分无需遍历
    sp++;

    // ---------- 4. 主遍历 ----------
    while (sp > 0)
    {
        sp--;
        SVOStackItem cur = stack[sp];

        // 核心 Early-Out：栈按 tMin 降序排列，一旦弹出的节点都超出 maxT，
        // 剩余所有节点必然更远，直接判定光源可见
        if (cur.tMin > maxT)
            return true;

        uint4 node = _SVONodes[cur.nodeIdx];
        uint childMask = node.x;
        uint data      = node.y;
        uint flags     = node.z;

        // ----- 叶子节点：命中实体 -----
        if ((flags & 256u) != 0u)
        {
            float voxelSizeF = float(1 << cur.level);
            float3 voxelMin = float3(cur.nodeMin);
            float3 voxelMax = voxelMin + voxelSizeF;

            // 跳过 hit voxel（containsSkip）或包含射线起点的叶子（roInsideLeaf）
            // containsSkip：阴影射线命中了主射线的 hit voxel → 自遮挡，跳过
            // roInsideLeaf：射线起点在该叶子内部（边界精度问题导致进入相邻体素）→ 跳过
            bool containsSkip = all(skipVoxel >= cur.nodeMin) && 
                                all(skipVoxel <  cur.nodeMin + int(1 << cur.level));
            bool roInsideLeaf = all(roGrid >= voxelMin) && all(roGrid < voxelMax);

            if (containsSkip || roInsideLeaf)
                continue;

            // 在 maxT 范围内命中了实体体素 → 被遮挡
            return false;
        }

        // ----- 内部节点：收集被射线穿过的非空子节点 -----
        int half = 1 << (cur.level - 1);
        float fHalf = float(half);
        float3 fNodeMin = float3(cur.nodeMin);

        float childTMin[4];
        float childTMax[4];
        int   childNodeIdx[4];
        int   childLevel[4];
        int3  childMin[4];
        int   childCount = 0;

        [unroll]
        for (int i = 0; i < 8; i++)
        {
            if ((childMask & (1u << i)) == 0u)
                continue; // SVO 核心剔除：空子节点直接跳过

            int cx = i & 1;
            int cy = (i >> 1) & 1;
            int cz = (i >> 2) & 1;

            float3 cMinF = fNodeMin + float3(cx * fHalf, cy * fHalf, cz * fHalf);
            float3 cMaxF = cMinF + fHalf;

            float3 cT0 = (cMinF - roGrid) * rdInv;
            float3 cT1 = (cMaxF - roGrid) * rdInv;
            float3 cTMin3 = min(cT0, cT1);
            float3 cTMax3 = max(cT0, cT1);
            float cTMin = max(max(cTMin3.x, cTMin3.y), cTMin3.z);
            float cTMax = min(min(cTMax3.x, cTMax3.y), cTMax3.z);

            // 与父节点有效区间取交集
            cTMin = max(cTMin, cur.tMin);
            cTMax = min(cTMax, cur.tMax);

            // 只保留在射线正方向、且在 maxT 范围内的子节点
            if (cTMin <= cTMax && cTMax >= 0.0 && cTMin <= maxT)
            {
                childTMin[childCount]    = cTMin;
                childTMax[childCount]    = cTMax;
                childNodeIdx[childCount] = (int)data + i;
                childLevel[childCount]   = cur.level - 1;
                childMin[childCount]     = cur.nodeMin + int3(cx * half, cy * half, cz * half);
                childCount++;
            }
        }

        // 按 tMin 降序压栈（最小 tMin 最后压，确保栈顶先处理最近的）
        if (childCount > 1)
        {
            for (int a = 0; a < childCount - 1; a++)
            {
                for (int b = a + 1; b < childCount; b++)
                {
                    if (childTMin[a] < childTMin[b])
                    {
                        float tmpF = childTMin[a]; childTMin[a] = childTMin[b]; childTMin[b] = tmpF;
                        tmpF = childTMax[a]; childTMax[a] = childTMax[b]; childTMax[b] = tmpF;
                        int tmpI = childNodeIdx[a]; childNodeIdx[a] = childNodeIdx[b]; childNodeIdx[b] = tmpI;
                        tmpI = childLevel[a]; childLevel[a] = childLevel[b]; childLevel[b] = tmpI;
                        int3 tmpM = childMin[a]; childMin[a] = childMin[b]; childMin[b] = tmpM;
                    }
                }
            }
        }

        for (int k = 0; k < childCount; k++)
        {
            if (sp < 64)
            {
                stack[sp].nodeIdx = childNodeIdx[k];
                stack[sp].level   = childLevel[k];
                stack[sp].nodeMin = childMin[k];
                stack[sp].tMin    = childTMin[k];
                stack[sp].tMax    = childTMax[k];
                sp++;
            }
        }
    }

    return true; // 遍历完毕未命中 → 光源可见
}

// ============================================================
//  NEE — BSDF 评估（VOX VoxelMaterial）
//  返回 BSDF 值 f(wo,wi)（含 cos(theta) 权重）和采样 PDF
// ============================================================
float3 EvalBSDF(VoxelMaterial mat, float3 N, float3 wo, float3 wi, out float bsdfPDF)
{
    bsdfPDF = 0.0;
    float NoL = dot(N, wi);

    if (abs(mat.type - 0.0f) < 0.5f || abs(mat.type - 4.0f) < 0.5f || abs(mat.type - 5.0f) < 0.5f)
    {
        // Diffuse / Cloud / Blend
        if (NoL <= 0.0 || dot(N, wo) <= 0.0) return float3(0, 0, 0);
        bsdfPDF = NoL * INV_PI;
        return mat.color * INV_PI * NoL;
    }
    else if (abs(mat.type - 1.0f) < 0.5f)
    {
        // Metal (GGX)
        if (NoL <= 0.0 || dot(N, wo) <= 0.0) return float3(0, 0, 0);
        float3 H = normalize(wo + wi);
        float NoH = max(dot(N, H), 1e-7f);
        float NoW = max(dot(N, wo), 1e-7f);
        float a2 = pow(mat.rough, 4.0);
        float d = NoH * NoH * (a2 - 1.0) + 1.0;
        float D = a2 / (PI * d * d);
        float G1_wi = SmithG1_GGX(wi, N, mat.rough);
        float G1_wo = SmithG1_GGX(wo, N, mat.rough);
        float G2 = G1_wi * G1_wo;
        float F = SchlickFresnel(mat.spec, max(dot(H, wo), 0.0));
        float3 spec = mat.color * F;
        float3 bsdf = spec * D * G2 / (4.0 * NoW * NoL);
        bsdfPDF = D * NoH / (4.0 * max(dot(wo, H), 1e-7f));
        return bsdf * NoL;
    }
    else if (abs(mat.type - 2.0f) < 0.5f)
    {
        // Glass: delta 分布，非精确方向返回 0
        return float3(0, 0, 0);
    }
    else if (abs(mat.type - 3.0f) < 0.5f)
    {
        // Emissive: 不参与 NEE
        return float3(0, 0, 0);
    }

    // 默认按 Diffuse 处理
    if (NoL <= 0.0 || dot(N, wo) <= 0.0) return float3(0, 0, 0);
    bsdfPDF = NoL * INV_PI;
    return mat.color * INV_PI * NoL;
}

// ============================================================
//  NEE — 环境光 PDF（当前：余弦加权半球）
// ============================================================
float EnvironmentLightPDF(float3 N, float3 dir)
{
    return max(0.0, dot(N, dir)) * INV_PI;
}

// ============================================================
//  NEE — 自发光体素 alias table 采样
//  按功率加权随机选取一个发光体素，返回索引
// ============================================================
uint SampleEmissiveAlias(inout uint seed)
{
    uint n = (uint)_EmissiveLightCount;
    if (n <= 1u) return 0u;
    float r1 = rand(seed);
    float r2 = rand(seed);
    uint idx = min((uint)(r1 * n), n - 1u);
    float2 entry = _EmissiveAliasTable[idx];
    return (r2 < entry.x) ? idx : (uint)entry.y;
}

// ============================================================
//  NEE — 自发光体素采样
//  从 alias table 按功率加权选一个发光体素，计算方向/距离/辐射度
//  返回 false = 超出距离或无效
// ============================================================
bool SampleEmissiveLight(float3 hitPosGrid, float3 NGrid,
                         inout uint seed, out DirectLight directLight)
{
    directLight.pdf = 0.0;
    directLight.distance = 0.0;
    directLight.radianceOverPdf = float3(0, 0, 0);
    directLight.direction = float3(0, 1, 0);

    if (_EmissiveLightCount <= 0 || _EmissiveTotalPower <= 0.0)
        return false;

    // 1. alias table 采样一个发光体素
    uint idx = SampleEmissiveAlias(seed);
    float4 lightData = _EmissiveLights[idx];

    // 2. 网格坐标 → 世界坐标中心
    float3 lightCenterWorld = (float3(lightData.xyz) + 0.5) * _SVOScale + _SVORootMin;
    float3 hitPosWorld = hitPosGrid * _SVOScale + _SVORootMin;

    // 3. 方向和距离
    float3 toLight = lightCenterWorld - hitPosWorld;
    float distWorld = length(toLight);
    if (distWorld < 1e-4f) return false;

    // 距离筛选（世界空间 100 单位）
    if (distWorld > 100.0f) return false;

    float3 lightDir = toLight / distWorld;

    // 法线半球检查
    if (dot(NGrid, lightDir) <= 0.0f) return false;

    // 4. 读取发光材质
    int matIdx = asint(lightData.w);
    VoxelMaterial emMat = ReadMaterial(matIdx);
    float3 emColor = pow(2.0f, emMat.flux) * emMat.color;

    // 5. radiance / discretePDF = color * totalPower（alias table 功率加权）
    //    d_grid² = d_world² / scale²，最终贡献中 scale² 正确抵消
    float distGrid2 = distWorld * distWorld / (_SVOScale * _SVOScale);
    directLight.radianceOverPdf = emColor * _EmissiveTotalPower / distGrid2;
    directLight.direction = lightDir;
    directLight.distance = distWorld;
    directLight.pdf = 1.0f;  // delta 光源，MIS weight = 1.0

    return true;
}

// ============================================================
//  NEE — 环境光采样（余弦半球 + Cubemap 查询）
//  当前阶段用余弦加权采样，未来升级为等距柱状投影重要性采样
// ============================================================
float3 SampleEnvironmentLight(float3 NGrid, inout uint seed,
                              out float3 lightDirGrid, out float lightPDF)
{
    lightDirGrid = SampleDiffuse(NGrid, seed);
    lightPDF = max(0.0, dot(NGrid, lightDirGrid)) * INV_PI;

    float3 lightDirWorld = GridDirToWorld(lightDirGrid);
    float3 radiance = SampleSky(lightDirWorld);
    return radiance / max(lightPDF, 1e-10f);
}

// ============================================================
//  NEE — 方向光（太阳）采样
//  Delta 光源：方向固定，PDF 为常数近似
// ============================================================
bool SampleSunLight(float3 NGrid, inout uint seed, out DirectLight directLight)
{
    directLight.pdf = 0.0;
    directLight.distance = INFINITE;
    directLight.radianceOverPdf = float3(0, 0, 0);
    directLight.direction = float3(0, 1, 0);

    if (_HasSun < 0.5f) return false;

    // 太阳方向从世界空间转到网格空间（SVO 网格=世界，轴方向一致）
    float3 sunDirGrid = normalize(_SunDir);
    float ndotl = dot(NGrid, sunDirGrid);
    if (ndotl <= 0.0f) return false;

    directLight.direction = sunDirGrid;
    directLight.radianceOverPdf = _SunColor;
    directLight.pdf = 1.0f;  // delta 光源，MIS weight = 1.0

    return true;
}

// ============================================================
//  NEE — 统一光源采样入口
//  HDR 环境光 + 方向光 + 自发光体素，one-sample MIS 混合
// ============================================================
void SampleLights(float3 hitPosGrid, float3 NGrid, float3 woGrid,
                  inout uint seed, out DirectLight directLight)
{
    directLight.pdf = 0.0;
    directLight.distance = INFINITE;
    directLight.radianceOverPdf = float3(0, 0, 0);
    directLight.direction = float3(0, 1, 0);

    float envWeight = (_HasSkyCube > 0.5f) ? 0.33f : 0.0f;
    float sunWeight = (_HasSun > 0.5f) ? 0.34f : 0.0f;
    float emWeight  = (_EmissiveLightCount > 0) ? 0.33f : 0.0f;
    float totalW = envWeight + sunWeight + emWeight;
    if (totalW < 1e-6f) return;

    // 按权重随机选择一种光源采样（one-sample MIS）
    float r = rand(seed) * totalW;

    if (r < envWeight && _HasSkyCube > 0.5f)
    {
        // ---- HDR 环境光采样 ----
        float3 lightDirGrid;
        float  envPDF;
        float3 radianceOverPdf = SampleEnvironmentLight(NGrid, seed, lightDirGrid, envPDF);

        directLight.direction = lightDirGrid;
        directLight.pdf = envPDF;  // 原始 PDF，选择概率在期望中自然消掉
        directLight.radianceOverPdf = radianceOverPdf;
        // distance 保持 INFINITE
    }
    else if (r < envWeight + sunWeight && _HasSun > 0.5f)
    {
        // ---- 方向光采样 ----
        DirectLight sunLight;
        if (SampleSunLight(NGrid, seed, sunLight))
        {
            directLight = sunLight;
            directLight.pdf = sunLight.pdf;  // 原始 PDF
        }
    }
    else if (_EmissiveLightCount > 0)
    {
        // ---- 自发光体素采样 ----
        DirectLight emLight;
        if (SampleEmissiveLight(hitPosGrid, NGrid, seed, emLight))
        {
            directLight = emLight;
            directLight.pdf = emLight.pdf;  // 原始 PDF
        }
    }
}

// ============================================================
//  BSDF 采样结果（参考 gltf_pathtrace.slang BsdfSampleData）
// ============================================================
struct BsdfSampleData
{
    float3 newDir;       // 新弹射方向（网格空间）
    float3 bsdf_over_pdf; // BSDF/PDF 比值（throughput 乘子）
    float  pdf;           // 采样 PDF
    int    eventType;     // 0=正常, 1=吸收
};

// ============================================================
//  BSDF 采样：根据材质类型采样新方向 + throughput 乘子 + PDF
//  参考 gltf_pathtrace.slang 的 bsdfSample() 架构
// ============================================================
void SampleBSDF(VoxelMaterial mat, float3 hitNGrid, float3 rdGrid,
                inout bool isInside, inout uint seed,
                out BsdfSampleData data)
{
    float3 NGrid = normalize(hitNGrid);
    data.eventType = 0;

    if (abs(mat.type - 0.0f) < 0.5f) // Diffuse
    {
        data.newDir = SampleDiffuse(NGrid, seed);
        data.bsdf_over_pdf = mat.color;  // (color/PI*cos) / (cos/PI) = color
        data.pdf = max(0.0, dot(NGrid, data.newDir)) * INV_PI;
    }
    else if (abs(mat.type - 1.0f) < 0.5f) // Metal (GGX)
    {
        float3 woGrid = normalize(-rdGrid);
        float3 H = SampleGGX(NGrid, mat.rough, seed);
        float3 wrGrid = reflect(-woGrid, H);
        float ndotwr = max(0.0, dot(NGrid, wrGrid));

        if (ndotwr > 0.0f)
        {
            data.newDir = normalize(wrGrid);
            float cosTheta = max(0.0, dot(H, woGrid));
            float F = SchlickFresnel(mat.spec, cosTheta);
            float G1_wi = SmithG1_GGX(woGrid, NGrid, mat.rough);
            float G1_wr = SmithG1_GGX(wrGrid, NGrid, mat.rough);
            data.bsdf_over_pdf = mat.color * F * (G1_wi / max(G1_wr, 1e-6f));

            float NoH = max(dot(NGrid, H), 1e-7f);
            float WoH = max(dot(woGrid, H), 1e-7f);
            float a2 = pow(mat.rough, 4.0);
            float d = NoH * NoH * (a2 - 1.0) + 1.0;
            float D = a2 / (PI * d * d);
            data.pdf = D * NoH / (4.0 * WoH);
        }
        else
        {
            data.eventType = 1;  // 吸收
            data.newDir = float3(0, 0, 0);
            data.bsdf_over_pdf = float3(0, 0, 0);
            data.pdf = 0.0;
        }
    }
    else if (abs(mat.type - 2.0f) < 0.5f) // Glass
    {
        float3 woGrid = normalize(-rdGrid);
        float cosTheta = dot(NGrid, woGrid);
        float etaI = isInside ? mat.ior : 1.0f;
        float etaT = isInside ? 1.0f : mat.ior;
        float eta = etaI / etaT;
        float F = SchlickFresnel(0.04f, abs(cosTheta));

        if (rand(seed) < F)
        {
            data.newDir = normalize(reflect(-woGrid, NGrid));
        }
        else
        {
            float3 wtGrid = refract(-woGrid, NGrid, eta);
            if (length(wtGrid) < 0.001f)
                data.newDir = normalize(reflect(-woGrid, NGrid));
            else
            {
                data.newDir = normalize(wtGrid);
                isInside = !isInside;
            }
        }
        data.bsdf_over_pdf = mat.color;
        data.pdf = 1.0f;  // delta 分布
    }
    else // Cloud / Blend 等，按 Diffuse 处理
    {
        data.newDir = SampleDiffuse(NGrid, seed);
        data.bsdf_over_pdf = mat.color;
        data.pdf = max(0.0, dot(NGrid, data.newDir)) * INV_PI;
    }
}

// ============================================================
//  路径追踪主循环（NEE + BSDF 双重采样 + MIS）
//
//  参考 gltf_pathtrace.slang 的 pathTrace() 结构：
//    for each depth:
//      1. Trace → SVO DDA 遍历
//      2. 未命中 → 天空贡献（MIS 加权）
//      3. 命中 → 读取材质
//         a. 自发光 → 直接累积
//         b. [NEE] SampleLights → EvalBSDF → 阴影射线 → MIS 累积
//         c. BSDF sample → 新方向 + throughput 更新 + PDF 记录
//         d. 俄罗斯轮盘赌 → 概率终止
// ============================================================
float3 PathTrace(float3 roWorld, float3 rdWorld, inout uint seed, out bool hitSky,
                 out float3 firstHitWorld)
{
    hitSky = false;
    firstHitWorld = float3(0, 0, 0);   // 首射线未命中几何体时保持零（sky 标记）
    float3 radiance   = float3(0, 0, 0);
    float3 throughput = float3(1, 1, 1);
    bool   isInside   = false;
    float  lastSamplePdf = 1e10f;   // BSDF 采样 PDF（首射线视为 DIRAC）
    float3 lastNGrid    = float3(0, 1, 0);  // 上次弹射的表面法线

    float3 roGrid = (roWorld - _SVORootMin) / _SVOScale;
    float3 rdGrid = rdWorld / _SVOScale;

    for (int depth = 0; depth < _MaxDepth; depth++)
    {
        bool firstRay = (depth == 0);

        // ---- SVO DDA 遍历 ----
        float hitT, hitSide;
        float3 hitNGrid;
        int3 hitVoxel;
        float3 hitPos;
        int matIndex = TraverseSVO_Stack(roGrid, rdGrid, hitT, hitPos, hitNGrid, hitSide, hitVoxel);

        // ---- 未命中 → 天空（含 MIS 权重）----
        if (matIndex < 0)
        {
            float3 skyCol = SampleSky(rdWorld);

            if (firstRay)
            {
                hitSky = true;
                return skyCol;  // 首射线无 MIS
            }

            // BSDF 弹射命中天空：用 MIS 平衡 NEE 与 BSDF 采样策略
            float envPdf = (_HasSkyCube > 0.5f)
                ? EnvironmentLightPDF(lastNGrid, rdGrid) : 0.0f;
            float misWeight = (lastSamplePdf > 1e9f) ? 1.0f
                : lastSamplePdf / (lastSamplePdf + max(envPdf, 1e-10f));
            radiance += throughput * misWeight * skyCol;
            return radiance;
        }

        // ---- 首射线命中点 → 世界坐标（DLSS MV/深度用；网格=世界仅平移缩放）----
        if (firstRay)
            firstHitWorld = hitPos * _SVOScale + _SVORootMin;

        // ---- 读取完整材质 ----
        VoxelMaterial mat = ReadMaterial(matIndex);

        // ---- 自发光材质 ----
        if (abs(mat.type - 3.0f) < 0.5f) // Emissive
        {
            radiance += throughput * pow(2.0f, mat.flux) * mat.color;
            return radiance;
        }

        // ======== NEE 直接光照估计 ========
        float3 directContrib = float3(0, 0, 0);
        bool isDeltaBSDF = (abs(mat.type - 2.0f) < 0.5f);  // Glass = delta，跳过 NEE

        if (!isDeltaBSDF)
        {
            float3 NGrid = normalize(hitNGrid);
            float3 woGrid = normalize(-rdGrid);

            // 1. 统一光源采样（当前仅 HDR 环境光，未来自动混合多种光源）
            DirectLight directLight;
            SampleLights(hitPos, NGrid, woGrid, seed, directLight);
            // 2. 有效性检查
            float ndotl = dot(NGrid, directLight.direction);
            bool nextEventValid = (ndotl > 0.0f) && (directLight.pdf > 0.0f);

            if (nextEventValid)
            {
                // 3. 评估 BSDF 向光源方向
                float bsdfPDF;
                float3 bsdfVal = EvalBSDF(mat, NGrid, woGrid,
                                          directLight.direction, bsdfPDF);

                if (any(bsdfVal > 0.0f) && bsdfPDF > 0.0f)
                {
                    // 4. MIS balance heuristic
                    float misWeight = (directLight.distance >= INFINITE)
                        ? directLight.pdf / (directLight.pdf + bsdfPDF)
                        : 1.0f;

                    bool visible = ShadowRayVisible_SVO(hitPos, directLight.direction, hitVoxel, directLight.distance);
                    if (visible)
                    {
                        directContrib = throughput
                            * directLight.radianceOverPdf
                            * misWeight * bsdfVal;
                    }
                }
            }
        }

        radiance += directContrib;

        // ---- BSDF 采样：确定下一弹射方向 ----
        BsdfSampleData bsdfData;
        SampleBSDF(mat, hitNGrid, rdGrid, isInside, seed, bsdfData);

        float3 newDirWorld = GridDirToWorld(bsdfData.newDir);
        throughput *= bsdfData.bsdf_over_pdf;
        lastSamplePdf = bsdfData.pdf;

        lastNGrid = normalize(hitNGrid);

        if (bsdfData.eventType == 1)
            break;

        // ---- 设置下一弹射线 ----
        roGrid = hitPos + bsdfData.newDir * 0.01f;
        rdGrid = bsdfData.newDir;
        rdWorld = newDirWorld;

        // ---- 俄罗斯轮盘赌 ----
        float rrPcont = min(max(throughput.x, max(throughput.y, throughput.z)) + 0.001f, 0.95f);
        if (rand(seed) >= rrPcont)
            break;
        throughput /= rrPcont;
    }

    return radiance;
}

// ============================================================
//  像素采样（含子像素抖动）
// ============================================================
float3 SamplePixel(float2 samplePos, float2 jitter, float2 imageSize,
                   float4x4 invVP, inout uint seed, out bool hitSky, out float3 firstHitWorld)
{
    float2 clipCoords = (samplePos + jitter) / imageSize * 2.0 - 1.0;
    float4 farWorld = mul(invVP, float4(clipCoords, 1.0, 1.0));
    farWorld /= farWorld.w;

    float3 rd = normalize(farWorld.xyz - _CameraPos);
    float3 ro = _CameraPos;

    // hitSky/firstHitWorld 由 out 参数直接返回
    float3 result = PathTrace(ro, rd, seed, hitSky, firstHitWorld);

    // 萤火虫抑制：仅对命中几何体的路径钳制，纯天空射线不钳制
    if (!hitSky)
    {
        float lum = dot(result, float3(0.2126, 0.7152, 0.0722));
        float fireflyMask = step(FIREFLY_THRESHOLD, lum);
        float clampedLum = lum * (1.0 - fireflyMask)
                         + (FIREFLY_THRESHOLD - FIREFLY_THRESHOLD * FIREFLY_THRESHOLD / (lum + 1e-6)) * fireflyMask;
        result *= clampedLum / max(lum, 1e-6);
    }

    return result;
}

// ============================================================
//  CSMain — 每像素路径追踪 + 时域累积
// ============================================================
[numthreads(8, 8, 1)]
void CSMain(uint3 dtid : SV_DispatchThreadID)
{
    uint2 pixel = dtid.xy;
    uint2 dims;
    _PathTracingResult.GetDimensions(dims.x, dims.y);
    if (pixel.x >= dims.x || pixel.y >= dims.y) return;

    float2 samplePos = (float2)pixel;
    float2 imageSize = float2(dims);

    // 随机种子（基于像素位置 + 帧号）
    uint seed = (uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + (uint)_FrameCount * 26699u) | 1u;

    // 子像素抗锯齿抖动（DLSS 变体：采样像素中心，抖动完全由 C# 侧
    // jittered 投影矩阵承担 → 实际采样位置 = 像素中心 + (jx, -jy)）
    float2 jitter;
    #ifdef DLSS_ON
    jitter = float2(0.5f, 0.5f);
    #else
    if (_FrameCount == 0)
        jitter = float2(0.5f, 0.5f); // 首帧：像素中心
    else
        jitter = float2(rand(seed), rand(seed)); // 后续帧：随机抖动
    #endif

    // 构建相机射线 + 路径追踪
    bool hitSky;
    float3 firstHitWorld;
    float3 color = SamplePixel(samplePos, jitter, imageSize, _InverseVP, seed, hitSky, firstHitWorld);

    #ifdef DLSS_ON
    // ---- DLSS 附加输出：运动向量 + hardware depth ----
    {
        if (hitSky)
        {
            // 天空像素：MV=0，深度=远平面
            _MotionVectorRT[pixel] = float2(0.0f, 0.0f);
            _DepthRT[pixel] = 1.0f;
            _PathTracingResult[pixel] = float4(color, 1.0);
            return;
        }

        float4 curClip  = mul(_CurVP,  float4(firstHitWorld, 1.0));
        float4 prevClip = mul(_PrevVP, float4(firstHitWorld, 1.0));

        // NDC → UV（与 SamplePixel 的 clipCoords 映射约定一致）
        float2 curUV  = curClip.xy  / max(curClip.w,  1e-6f) * 0.5 + 0.5;
        float2 prevUV = prevClip.xy / max(prevClip.w, 1e-6f) * 0.5 + 0.5;

        // DLSS 约定：MV 指向上一帧位置（像素单位）
        _MotionVectorRT[pixel] = (prevUV - curUV) * imageSize;

        // hardware depth：近=0 远=1（Unity D3D12 非反转深度）
        _DepthRT[pixel] = saturate(curClip.z / max(curClip.w, 1e-6f));

        // DLSS 路径不做时域累积：单帧 1spp 直接输出（降噪交给 DLSS）
        _PathTracingResult[pixel] = float4(color, 1.0);
        return;
    }
    #endif

    // ---- 时域累积（回退路径：DLSS 不可用时）----
    if (_FrameCount == 0)
    {
        _PathTracingResult[pixel] = float4(color, 1.0);
    }
    else
    {
        float4 old = _PathTracingResult[pixel];
        float totalSamples = (float)(_FrameCount + 1);
        float3 accumulated = (old.rgb * (totalSamples - 1.0f) + color) / totalSamples;
        _PathTracingResult[pixel] = float4(accumulated, 1.0);
    }
}
